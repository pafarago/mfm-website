{
  "$schema": "https://schemas.wp.org/wp/6.8/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "gradients": [],
      "duotone": [],
      "palette": [
        { "slug": "text", "name": "Text", "color": "#1f2933" },
        { "slug": "muted", "name": "Muted", "color": "#52606d" },
        { "slug": "green", "name": "Green", "color": "#1e7b34" },
        { "slug": "green-tint", "name": "Green tint", "color": "#e7f2ea" },
        { "slug": "blue", "name": "Link blue", "color": "#1d5fa8" },
        { "slug": "page", "name": "Page grey", "color": "#f5f5f7" },
        { "slug": "border", "name": "Border", "color": "#cfd8e3" },
        { "slug": "white", "name": "White", "color": "#ffffff" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.9375rem" },
        { "slug": "medium", "name": "Normal", "size": "1.125rem" },
        { "slug": "large", "name": "Large", "size": "1.375rem" },
        { "slug": "x-large", "name": "Extra large", "size": "1.75rem" }
      ],
      "dropCap": false
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1160px"
    },
    "spacing": {
      "units": [ "px", "em", "rem", "%", "vw" ]
    }
  },
  "styles": {
    "color": {
      "text": "#1f2933"
    },
    "typography": {
      "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": { "color": { "text": "#1d5fa8" } },
      "button": {
        "color": { "background": "#1e7b34", "text": "#ffffff" },
        "border": { "radius": "10px" }
      }
    }
  }
}
