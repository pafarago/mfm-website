# /srv/mfm/deploy.conf — read by the pre-receive hook and rollback.sh.

# Where the bare repo, releases and "current" live.
BASE=/srv/mfm

# The live WordPress wp-content folder.
WP_CONTENT=/var/www/midlothianfriends/wp-content

# The web root, where the repo's site/ pages are linked. Defaults to the
# folder above WP_CONTENT, so an older deploy.conf without it still works.
WEB_ROOT=/var/www/midlothianfriends

# Only pushes to this branch are deployed.
BRANCH=main

# Release folders to keep for rollback.
KEEP=5

# Run after each switch so PHP drops its cached code. Reload the service that
# actually runs PHP: php8.x-fpm when Apache hands PHP to PHP-FPM (as on the
# droplet), apache2 only for mod_php. server-setup.sh detects and sets this.
# Needs a matching sudoers entry (see README).
RELOAD_CMD="sudo /usr/bin/systemctl reload php8.5-fpm"
